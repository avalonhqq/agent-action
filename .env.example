# Copy this file to .env for local development.
BILI_SUPPORT_ENVIRONMENT=local
BILI_SUPPORT_DEBUG=false
BILI_SUPPORT_HOST=127.0.0.1
BILI_SUPPORT_PORT=8010
BILI_SUPPORT_LOG_LEVEL=INFO
BILI_SUPPORT_LLM_PROVIDER=mock
BILI_SUPPORT_LLM_BASE_URL=https://api.openai.com/v1
BILI_SUPPORT_LLM_MODEL=mock-support-model
BILI_SUPPORT_LLM_STRUCTURED_OUTPUT_MODE=json_schema
BILI_SUPPORT_LLM_MOCK_RESPONSE=这是来自确定性 Mock Provider 的客服回复。
BILI_SUPPORT_INTENT_MOCK_RESPONSE={"route":"supported","intents":[{"domain":"membership","action":"query","confidence":0.9}],"entities":[],"sentiment":"neutral","risk":"low","confidence":0.9,"needs_clarification":false,"clarification_question":null,"source":"model"}
BILI_SUPPORT_INTENT_PROMPT_VERSION=3
BILI_SUPPORT_INTENT_PARSE_RETRIES=1
BILI_SUPPORT_GROUNDED_PARSE_RETRIES=1
# 生产Claim校验：本地真实NLI，模型不可用时失败关闭，不回退Mock。
BILI_SUPPORT_CLAIM_VERIFICATION_MODE=enforce
BILI_SUPPORT_CLAIM_VERIFICATION_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli
BILI_SUPPORT_CLAIM_VERIFICATION_CACHE_DIR=./data/models/huggingface
BILI_SUPPORT_CLAIM_VERIFICATION_DEVICE=auto
BILI_SUPPORT_CLAIM_VERIFICATION_LOCAL_FILES_ONLY=false
BILI_SUPPORT_CLAIM_VERIFICATION_WARMUP=true
BILI_SUPPORT_CLAIM_ENTAILMENT_THRESHOLD=0.65
BILI_SUPPORT_CLAIM_CONTRADICTION_THRESHOLD=0.70
BILI_SUPPORT_CLAIM_VERIFICATION_MAX_LENGTH=512
BILI_SUPPORT_LLM_MAX_RETRIES=2
BILI_SUPPORT_LLM_RETRY_BASE_DELAY=0.1
BILI_SUPPORT_LLM_TEMPERATURE=0.0
BILI_SUPPORT_LLM_MAX_TOKENS=512
BILI_SUPPORT_LLM_TIMEOUT_SECONDS=30.0
BILI_SUPPORT_DATABASE_URL=sqlite+aiosqlite:///./data/bili_support.db
BILI_SUPPORT_DATABASE_ECHO=false
BILI_SUPPORT_DATABASE_AUTO_CREATE=true
# LangGraph Checkpoint；本地Compose使用单节点Replica Set，生产需认证/TLS和多节点。
BILI_SUPPORT_GRAPH_CHECKPOINT_ENABLED=false
BILI_SUPPORT_GRAPH_CHECKPOINT_REQUIRED=false
BILI_SUPPORT_GRAPH_CHECKPOINT_MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true&replicaSet=rs0
BILI_SUPPORT_GRAPH_CHECKPOINT_DATABASE=bili_support_graph
BILI_SUPPORT_GRAPH_CHECKPOINT_COLLECTION=checkpoints
BILI_SUPPORT_GRAPH_CHECKPOINT_WRITES_COLLECTION=checkpoint_writes
BILI_SUPPORT_GRAPH_CHECKPOINT_TTL_SECONDS=604800
BILI_SUPPORT_GRAPH_CHECKPOINT_CONNECT_TIMEOUT_SECONDS=5
# 生产必须由Secret Manager注入16/24/32字节密钥；不要提交真实值。
# BILI_SUPPORT_GRAPH_CHECKPOINT_ENCRYPTION_KEY=
BILI_SUPPORT_REDIS_ENABLED=false
BILI_SUPPORT_REDIS_REQUIRED=false
BILI_SUPPORT_REDIS_URL=redis://127.0.0.1:6379/0
BILI_SUPPORT_REDIS_HISTORY_TTL_SECONDS=900
BILI_SUPPORT_REDIS_HISTORY_MAX_MESSAGES=100
BILI_SUPPORT_KNOWLEDGE_STORAGE_DIR=./data/knowledge/files
BILI_SUPPORT_KNOWLEDGE_MAX_FILE_BYTES=10485760
BILI_SUPPORT_EMBEDDING_PROVIDER=mock
BILI_SUPPORT_EMBEDDING_MODEL=mock-hash-embedding-v1
BILI_SUPPORT_EMBEDDING_DIMENSION=128
BILI_SUPPORT_EMBEDDING_BATCH_SIZE=64
BILI_SUPPORT_EMBEDDING_TIMEOUT_SECONDS=30
BILI_SUPPORT_KNOWLEDGE_INDEX_CHUNK_SCHEMA_VERSION=small-to-big-v1
BILI_SUPPORT_VECTOR_STORE=milvus
BILI_SUPPORT_MILVUS_ENABLED=false
BILI_SUPPORT_MILVUS_REQUIRED=false
BILI_SUPPORT_MILVUS_URI=http://127.0.0.1:19530
BILI_SUPPORT_MILVUS_TOKEN=root:Milvus
BILI_SUPPORT_MILVUS_COLLECTION=bili_support_child_v2

# Elasticsearch词法BM25；本地Docker仅绑定127.0.0.1且关闭安全，生产环境必须使用TLS和凭据。
BILI_SUPPORT_ELASTICSEARCH_ENABLED=false
BILI_SUPPORT_ELASTICSEARCH_REQUIRED=false
BILI_SUPPORT_ELASTICSEARCH_URL=http://127.0.0.1:9200
BILI_SUPPORT_ELASTICSEARCH_INDEX_PREFIX=bili-support-child
BILI_SUPPORT_ELASTICSEARCH_READ_ALIAS=bili-support-child-read
BILI_SUPPORT_ELASTICSEARCH_USERNAME=
BILI_SUPPORT_ELASTICSEARCH_PASSWORD=
BILI_SUPPORT_ELASTICSEARCH_REQUEST_TIMEOUT_SECONDS=10
BILI_SUPPORT_ELASTICSEARCH_BATCH_SIZE=200
BILI_SUPPORT_MILVUS_CONSISTENCY_LEVEL=Session
BILI_SUPPORT_MILVUS_INDEX_M=16
BILI_SUPPORT_MILVUS_INDEX_EF_CONSTRUCTION=200
BILI_SUPPORT_MILVUS_SEARCH_EF=64
BILI_SUPPORT_BM25_TOKENIZER=jieba
BILI_SUPPORT_BM25_JIEBA_HMM_ENABLED=false
BILI_SUPPORT_BM25_USER_DICTIONARY_PATH=./data/dictionaries/bilibili_support.txt
BILI_SUPPORT_CUSTOMER_RETRIEVAL_MODE=hybrid
BILI_SUPPORT_RERANK_PROVIDER=mock
BILI_SUPPORT_RERANK_MODEL=mock-reranker-v1
BILI_SUPPORT_RERANK_TIMEOUT_SECONDS=10
BILI_SUPPORT_RERANK_MAX_CONCURRENCY=4
BILI_SUPPORT_RERANK_CANDIDATE_K=10
BILI_SUPPORT_RERANK_PARSE_RETRIES=1
BILI_SUPPORT_CUSTOMER_RERANK_ENABLED=false
BILI_SUPPORT_API_TOKEN=local-demo-token
BILI_SUPPORT_UI_ENABLED=true
BILI_SUPPORT_UI_PREFILL_DEMO_CREDENTIALS=false
BILI_SUPPORT_UI_STORAGE_SECRET=local-ui-storage-secret-change-me

# Set only in a local .env or secret manager; never commit a real key.
# BILI_SUPPORT_LLM_API_KEY=

# MySQL example (put the real password only in local .env or a secret manager):
# BILI_SUPPORT_DATABASE_URL=mysql+aiomysql://bili_support:change-me@127.0.0.1:3306/bili_support?charset=utf8mb4
